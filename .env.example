# --- OpenAI ---
# OPENAI_API_KEY is no longer used for tenant chat calls — each tenant's own
# key is fetched from Tenant.openaiApiKey via DATABASE_URL below (same as
# AI Boardroom / agent-botivateOS). Only the chat/embedding model names matter here.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Shared with backend_botivate_os (must match exactly) ---
JWT_SECRET=your-secret-key

# --- Node backend connectivity ---
NODE_BACKEND_URL=http://localhost:5000/api

# --- Shared Postgres — same DB backend_botivate_os and agent-botivateOS use ---
# Required for per-tenant OpenAI key lookup (Tenant.openaiApiKey).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Vector store ---
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma

# --- Knowledge base ---
KNOWLEDGE_BASE_DIR=./knowledge_base
DEPARTMENT_MODULE_MAP_PATH=./config/department_module_map.yaml

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
